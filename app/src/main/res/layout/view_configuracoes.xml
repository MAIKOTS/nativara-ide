<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#18181B"
    android:orientation="vertical">

    <!-- ===================== HEADER ===================== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.1"
            android:text="CONFIGURAÇÕES"
            android:textColor="#00E676"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#27272A" />

    <!-- ===================== SCROLL DE ITENS ===================== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- ========== GERAL ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.15"
                android:text="GERAL"
                android:textColor="#00E676"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Opção: Notificações -->
            <TextView
                android:id="@+id/opcNotificacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:text="Notificações"
                android:textColor="#E4E4E7"
                android:textSize="14sp" />

            <!-- Opção: Verificar Atualizações -->
            <TextView
                android:id="@+id/opcVerificarAtualizacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:text="Verificar atualizações"
                android:textColor="#E4E4E7"
                android:textSize="14sp" />

            <!-- ========== SOBRE ========== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="6dp"
                android:letterSpacing="0.15"
                android:text="SOBRE"
                android:textColor="#00E676"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Opção: Informações da IDE -->
            <TextView
                android:id="@+id/opcInformacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="16dp"
                android:text="Informações da IDE"
                android:textColor="#E4E4E7"
                android:textSize="14sp" />

            <!-- Rodapé -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="Nativara IDE • v1.00\nFeito por MaikoTS"
                android:textColor="#3F3F46"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>